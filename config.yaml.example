# 什么值得买好价监控 - 配置文件
# 复制为 config.yaml 后修改

filter:
  blacklist_categories: []
  blacklist_ids: []
  blacklist_keywords:
    - 拼多多
    - pdd
    - 百亿补贴
  blacklist_malls: []
  whitelist_ids: []
  whitelist_keywords: []

monitor:
  interval: 300          # 监控间隔（秒）
  items_per_page: 20     # 每页条数
  max_pages: 50          # 最大翻页数
  target_minutes: 30     # 目标覆盖时间（分钟），动态翻页
  quiet_hours:           # 免打扰时段（北京时间）
    enabled: false
    start: '00:30'
    end: '07:30'

notifier:
  email:
    from_name: SMZDM监控
    smtp_port: 587
    smtp_server: smtp.qq.com
    to_email: 809153781@qq.com
    use_tls: true
    username: 809153781@qq.com
    # password 通过 .env 的 SMTP_PASSWORD 注入

proxy:
  enabled: false

scorer:
  filters:
    min_worthy: 15  # 值≥此数才评分（核心门槛）
  min_age_hours: 1
  min_composite_score: 50
  weights:
    comments: 0.1
    collection: 3
    worthy: 1.5
    unworthy: -2
    price: 0.15

storage:
  db_path: ./data/smzdm.db
  retention_days: 30
